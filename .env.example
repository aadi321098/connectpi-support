# ==============================================================================
# ConnectPi Support - Environment Variables Template
# ==============================================================================

# 1. Base URLs & Environment
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=https://connectpi.in
NODE_ENV=development
STRICT_CONTENT=false

# 2. Resend Email Service (Contact form ticket delivery)
# Dashboard: https://resend.com/api-keys
RESEND_API_KEY=re_mock_test_key_1234567890
SUPPORT_FROM_EMAIL=ConnectPi Support <support@connectpi.in>
SUPPORT_TO_EMAIL=support@connectpi.in

# 3. Cloudflare Turnstile (Anti-bot protection)
# Dashboard: https://dash.cloudflare.com/ -> Turnstile
# (Official Cloudflare testing keys that always pass):
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# 4. Upstash Redis (Distributed rate limiting: 5 req/hr per IP)
# Dashboard: https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=https://mock-connectpi-ratelimit.upstash.io
UPSTASH_REDIS_REST_TOKEN=mock_upstash_token_abcdef123456

# 5. Sentry Error Monitoring (Optional)
# Dashboard: https://sentry.io/
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# 6. Cookieless Privacy Analytics (Optional - Plausible or Vercel Analytics)
NEXT_PUBLIC_ANALYTICS_ID=
